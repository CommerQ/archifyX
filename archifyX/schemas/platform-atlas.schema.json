{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cursor.local/archifyX/schemas/platform-atlas.schema.json",
  "title": "archifyX",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "meta", "overview", "modules"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "platform-atlas" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "locale": { "enum": ["en", "zh-CN"] },
        "description": { "type": "string", "maxLength": 400 },
        "engineRoot": {
          "type": "string",
          "minLength": 1,
          "description": "Optional override for the in-tree diagram engine root. Default: <skill>/engine"
        },
        "archifyRoot": {
          "type": "string",
          "minLength": 1,
          "description": "Deprecated alias of engineRoot (ignored if engine is bundled)."
        },
        "outputDir": { "type": "string", "minLength": 1 },
        "railPosition": { "enum": ["left", "right"] }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type", "spec", "artifact"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "type": { "const": "architecture" },
        "summary": { "type": "string", "maxLength": 240 },
        "spec": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": { "$ref": "#/$defs/module" }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "summary": { "type": "string", "maxLength": 280 },
        "anchors": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" }
        },
        "diagrams": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "title", "spec", "artifact"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$" },
              "type": {
                "enum": ["architecture", "workflow", "sequence", "dataflow", "lifecycle"]
              },
              "title": { "type": "string", "minLength": 1, "maxLength": 120 },
              "summary": { "type": "string", "maxLength": 240 },
              "spec": { "type": "string", "minLength": 1 },
              "artifact": { "type": "string", "minLength": 1 },
              "status": { "enum": ["planned", "draft", "delivered"] }
            }
          }
        },
        "children": {
          "type": "array",
          "maxItems": 12,
          "items": { "$ref": "#/$defs/module" },
          "description": "Nested submodules. Side rail renders as a tree. Output under modules/<parent>/…/<id>/."
        }
      }
    }
  }
}
